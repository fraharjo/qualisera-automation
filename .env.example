# ==========================================
# 🌐 Web Automation Settings
# ==========================================
WEB_BASE_URL="https://example.com"
WEB_BROWSER="chrome"
HEADLESS="true"

# ==========================================
# 🤖 Android Automation (Appium)
# ==========================================
ANDROID_APP_PATH="./apps/app.apk"
ANDROID_DEVICE_NAME="Android Emulator"
ANDROID_PLATFORM_VERSION="14.0"
ANDROID_AUTOMATION_NAME="UiAutomator2"

# ==========================================
# 🍎 iOS Automation (Appium)
# ==========================================
IOS_APP_PATH="./apps/app.ipa"
IOS_DEVICE_NAME="iPhone 15 Pro"
IOS_PLATFORM_VERSION="17.0"
IOS_AUTOMATION_NAME="XCUITest"

# ==========================================
# 👥 Universal Test Credentials (Web, Android, iOS)
# ==========================================
TEST_STANDARD_USER="tester@example.com"
TEST_STANDARD_PASSWORD="Password123!"
TEST_ADMIN_USER="admin@example.com"
TEST_ADMIN_PASSWORD="AdminPassword123!"
TEST_LOCKED_USER="locked_account@example.com"

# ==========================================
# ⚙️ Appium Server & Runner Settings
# ==========================================
APPIUM_HOST="127.0.0.1"
APPIUM_PORT=4723
DEFAULT_TIMEOUT=15000

# ==========================================
# 📧 Email Reporter Settings (SMTP)
# ==========================================
EMAIL_REPORT_ENABLED="false"
EMAIL_TRIGGER_POLICY="manual" # Options: manual | on_failure | ci_only | always
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="qa.automation@yourcompany.com"
SMTP_PASS="your-app-password"
SMTP_FROM='"Qualisera QA Automation" <qa.automation@yourcompany.com>'
EMAIL_TO="qa-leads@yourcompany.com, engineering@yourcompany.com"
REPORT_DASHBOARD_URL="https://reports.yourcompany.com/allure"
