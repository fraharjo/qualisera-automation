   <Row ss:Height="22">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">TC-001</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">cart</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">@REQ-AMRE-103</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Product added from PDP reflects in cart with matching title, price, and color</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Smoke / Critical Path</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">P0 (Smoke / Critical)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Automated</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">@feature-cart @JIRA-AMRE-103 @REQ-AMRE-103 @AC-01 @p0 @smoke @automated @web @functional @TC-CART-01</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Given the user adds &quot;Clara Stripe Knit Sweater&quot; with variation &quot;Black&quot; to the cart | When the user navigates directly to the cart page | Then the filled cart container should be displayed | And the cart should contain at least 1 line item | And the first line item title should contain &quot;Clara Stripe Knit Sweater&quot; | And the first line item price should display a valid IDR currency format</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">the first line item price should display a valid IDR currency format</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">TC-002</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">cart</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">@REQ-AMRE-103</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Quantity stepper increases item quantity and recalculates subtotal</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Smoke / Critical Path</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">P0 (Smoke / Critical)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Automated</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">@AC-02 @p0 @smoke @automated @web @functional @TC-CART-02</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Given the user has &quot;Elise Stripe Knit Sweater&quot; in the cart | And the user is on the cart page | When the user clicks the quantity increase button for the item | Then the item quantity in cart should update to &quot;2&quot; | And the cart subtotal should dynamically update to reflect the new quantity</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">the cart subtotal should dynamically update to reflect the new quantity</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">TC-003</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">cart</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">@REQ-AMRE-103</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Quantity stepper at minimum boundary does not decrease below 1</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Boundary Value Analysis</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">P1 (Regression)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Automated</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">@AC-02 @p1 @regression @automated @web @bva @TC-CART-03</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Given the user has &quot;Clara Stripe Knit Sweater&quot; in the cart with quantity 1 | And the user is on the cart page | When the user clicks the quantity decrease button for the item | Then the item quantity in cart should remain &quot;1&quot;</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">the item quantity in cart should remain &quot;1&quot;</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">TC-004</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">cart</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">@REQ-AMRE-103</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Removing the only item triggers empty cart state</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Positive Functional</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">P1 (Regression)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Automated</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">@AC-03 @p1 @regression @automated @web @functional @TC-CART-04</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Given the user has &quot;Clara Stripe Knit Sweater&quot; in the cart | And the user is on the cart page | When the user removes the item from the cart | Then the empty cart state container should be displayed | And the cart line items should no longer be present</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">the cart line items should no longer be present</Data></Cell>
   </Row>
