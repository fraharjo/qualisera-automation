{
  "compilerOptions": {
    "moduleResolution": "node",
    "module": "commonjs",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "types": [
      "node",
      "@wdio/globals/types",
      "@wdio/cucumber-framework"
    ],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"],
      "@features/*": ["features/*"]
    }
  },
  "include": [
    "shared/**/*.ts",
    "features/**/*.ts",
    "wdio.*.conf.ts"
  ]
}
